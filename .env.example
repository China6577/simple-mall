# 复制本文件为 .env 后修改为自己的配置

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# MySQL
DB_ROOT_PASSWORD=root_password
DB_NAME=mall
DB_USER=mall_user
DB_PASSWORD=mall_password
DB_HOST=mysql
DB_PORT=3306
# 生产环境连接池配置（可选）
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT（分钟/天）
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# 订单超时取消时间（秒），默认 30 分钟
ORDER_AUTO_CANCEL_SECONDS=1800

# 邮件
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mall.local

# 管理员账号
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@mall.local
DJANGO_ADMIN_PASSWORD=admin123456

# 是否加载演示数据（1=加载，0=不加载）
DEMO_DATA=1
